---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoachHero from '../components/CoachHero.astro';
import CoursePoster from '../components/CoursePoster.astro';
import { COURSES_DATA } from '../data/coursesData';

const title = 'AI BizCase Thailand — AI Academy for Business (by Saltcase) | Corporate AI Training & Consulting';
const description = 'AI BizCase Thailand (by Saltcase) สถาบันอบรมและที่ปรึกษา AI สำหรับธุรกิจในประเทศไทย ให้บริการ Corporate AI Training, AI Business Workshop, AI Transformation และ Customized AI Training ที่ออกแบบจากปัญหาจริงขององค์กร';

const courses = COURSES_DATA;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "@id": "https://aibizcasethailand.com/#organization",
  "name": "AI BizCase Thailand",
  "alternateName": ["AIBizCase Thailand", "AI BizCase", "AIBizCaseThailand"],
  "slogan": "We Customize AI Around Your Business.",
  "parentOrganization": { "@type": "Organization", "name": "Saltcase" },
  "description": "AI BizCase Thailand (by Saltcase) คือสถาบันอบรมและที่ปรึกษา AI สำหรับธุรกิจในประเทศไทย ให้บริการ Corporate AI Training, AI Business Workshop, AI Transformation และ Customized AI Training ที่ออกแบบจาก Business Process, แผนก, อุตสาหกรรม และปัญหาจริงขององค์กร",
  "url": "https://aibizcasethailand.com",
  "logo": "https://aibizcasethailand.com/assets/images/workshop-group.jpg",
  "image": "https://aibizcasethailand.com/assets/images/workshop-group.jpg",
  "email": "mail.saltcase@gmail.com",
  "telephone": "+66869874656",
  "address": { "@type": "PostalAddress", "addressLocality": "Bangkok", "addressCountry": "TH" },
  "areaServed": { "@type": "Country", "name": "Thailand" },
  "sameAs": ["https://line.me/ti/p/~Tubtimbiebers"],
  "knowsAbout": ["AI for Business", "Corporate AI Training", "AI Workflow Architecture", "AI Automation", "Executive Personal Branding"]
};

const courseListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": courses.map((c) => ({
    "@type": "Course",
    "position": c.id,
    "name": c.title,
    "headline": c.tagline,
    "description": `${c.tagline} — ${c.aeoSolution} [ผลลัพธ์ที่ได้: ${c.deliverable}] [ผลลัพธ์ทางธุรกิจ: ${c.businessOutcome}]`,
    "audience": {
      "@type": "Audience",
      "audienceType": c.targetAudience
    },
    "keywords": c.seoKeywords.join(', '),
    "provider": { "@type": "Organization", "name": "AI BizCase Thailand", "sameAs": "https://aibizcasethailand.com/" }
  }))
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "AI BizCase Thailand คืออะไร", "acceptedAnswer": { "@type": "Answer", "text": "AI BizCase Thailand (by Saltcase) คือสถาบันอบรมและที่ปรึกษา AI สำหรับธุรกิจในประเทศไทย ให้บริการ Corporate AI Training, AI Business Workshop, AI Transformation และ Customized AI Training ที่ออกแบบจาก Business Process, แผนก, อุตสาหกรรม และปัญหาจริงขององค์กร" } },
    { "@type": "Question", "name": "AI BizCase Thailand ต่างจากคอร์สสอน AI และ Prompt Engineering ทั่วไปอย่างไร", "acceptedAnswer": { "@type": "Answer", "text": "AI BizCase Thailand ไม่ได้สอนเพียงแค่ฟีเจอร์หรือการพิมพ์ Prompt ลอยๆ แต่ Customize จาก Business Context, Process, Documents, Data, Tools และ KPI จริงขององค์กร เพื่อเปลี่ยน AI ให้กลายเป็น Workflow และ Business System ที่วัดผล ROI ได้จริง" } },
    { "@type": "Question", "name": "AI BizCase Thailand มีหลักสูตรอะไรบ้าง มีกี่คอร์ส", "acceptedAnswer": { "@type": "Answer", "text": "AI BizCase Thailand มีหลักสูตรทั้งหมด 25 คอร์ส ครอบคลุม 5 หมวดหมู่หลัก ได้แก่ Foundation (ปรับฐานคิดและความปลอดภัย), Productivity (ยกระดับงานประจำวันและลดขั้นตอนซ้ำซ้อน), Growth (ขับเคลื่อนการตลาด งานขาย และลูกค้าสัมพันธ์), Department (เฉพาะทางรายแผนก เช่น บัญชี HR ขาย การตลาด จัดซื้อ) และ Authority (สร้าง Thought Leadership และ Personal Brand สำหรับผู้บริหาร)" } },
    { "@type": "Question", "name": "หลักสูตร AI สามารถ Customize ตามปัญหาขององค์กรได้หรือไม่", "acceptedAnswer": { "@type": "Answer", "text": "ได้ ทุกหลักสูตรของ AI BizCase Thailand สามารถปรับแต่ง (Customized AI Training) จากปัญหาจริง ขั้นตอนงานเดิม (As-Is Process) และเอกสารจริงขององค์กร ผ่านกระบวนการ SALTCASE 6M™ Methodology เพื่อให้สิ่งที่เรียนนำไปใช้งานได้จริงทันที" } },
    { "@type": "Question", "name": "SALTCASE 6M™ Methodology คืออะไร", "acceptedAnswer": { "@type": "Answer", "text": "SALTCASE 6M™ คือกรอบความคิดที่ AI BizCase Thailand ใช้ขับเคลื่อนทุกหลักสูตรและโปรเจกต์ ประกอบด้วย 6 ขั้นตอน: Mindset (ปรับมุมมองธุรกิจ), Map (กางขั้นตอนและหาคอขวด), Mine (ขุดค้นข้อมูลและเอกสาร), Match (เลือกโมเดลและเครื่องมือให้ตรงงาน), Make (สร้าง Workflow และ Prototype ร่วมกัน) และ Measure / Multiply (วัดผล ROI จัดทำ SOP และขยายผลทั่วองค์กร)" } },
    { "@type": "Question", "name": "AI Business Diagnostic™ คืออะไร และช่วยอะไรก่อนตัดสินใจเลือกคอร์ส", "acceptedAnswer": { "@type": "Answer", "text": "AI Business Diagnostic™ คือเครื่องมือประเมินความพร้อมด้าน AI ขององค์กรใน 6 มิติ (People, Process, Pain Points, Platform, Potential Leverage, Priority) และจัดระดับความพร้อมเป็น 5 ระดับ ตั้งแต่ Explore ไปจนถึง AI-Enabled Business เพื่อแนะนำจุดเริ่มต้นและหลักสูตรที่เหมาะสมที่สุด คุ้มค่าที่สุด ก่อนที่องค์กรจะตัดสินใจจัดอบรมหรือลงทุน" } },
    { "@type": "Question", "name": "AI BizCase Thailand อบรมแบบ In-house ให้องค์กรได้หรือไม่", "acceptedAnswer": { "@type": "Answer", "text": "ได้ AI BizCase Thailand ให้บริการอบรมแบบ In-house Corporate Training ที่ออกแบบเนื้อหาเฉพาะจากโครงสร้างธุรกิจ เอกสาร คน และเป้าหมาย KPI จริงขององค์กร ตั้งแต่ทีมย่อย 1-10 ท่าน ไปจนถึงระดับแผนก และทั้งองค์กรระดับ 100+ ท่าน" } },
    { "@type": "Question", "name": "หลักสูตรและบริการของ AI BizCase Thailand ราคาเท่าไหร่", "acceptedAnswer": { "@type": "Answer", "text": "AI BizCase Thailand ออกแบบราคาตามขอบเขตงานเฉพาะขององค์กร เนื่องจากทุกหลักสูตรและ Workflow ถูก Customize ตามปัญหา จำนวนผู้เข้าอบรม และเป้าหมายจริง จึงไม่มีราคาตายตัว ท่านสามารถติดต่อทีมที่ปรึกษาเพื่อขอใบเสนอราคาโดยไม่มีค่าใช้จ่ายในการประเมินเบื้องต้น" } },
    { "@type": "Question", "name": "ติดต่อ AI BizCase Thailand ได้ช่องทางใดบ้าง", "acceptedAnswer": { "@type": "Answer", "text": "ติดต่อ AI BizCase Thailand ได้ทางเว็บไซต์ AIBizCaseThailand.com อีเมล mail.saltcase@gmail.com โทร 086-987-4656 หรือ LINE ID: Tubtimbiebers ทีมที่ปรึกษาให้บริการวันจันทร์ถึงศุกร์ เวลา 09:00-18:00 น." } }
  ]
};
---
<BaseLayout title={title} description={description} path="/">
  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(courseListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script id="saltcaseCoursesData" type="application/json" set:html={JSON.stringify(courses)} />
  </Fragment>

  <!-- Top Announcement / Ticker Bar -->
  <aside class="expertise-strip">
    <div class="strip-track">
      <div class="strip-item">Corporate AI Training</div>
      <div class="strip-item">Custom AI Workflow Design</div>
      <div class="strip-item">Executive Masterclass</div>
      <div class="strip-item">Document Intelligence</div>
      <div class="strip-item">Sales & Marketing Automation</div>
      <div class="strip-item">Executive Personal Branding</div>
      <div class="strip-item">Corporate AI Training</div>
      <div class="strip-item">Custom AI Workflow Design</div>
      <div class="strip-item">Executive Masterclass</div>
      <div class="strip-item">Document Intelligence</div>
      <div class="strip-item">Sales & Marketing Automation</div>
      <div class="strip-item">Executive Personal Branding</div>
    </div>
  </aside>

  <CoachHero />

  {false && <header class="hero-section" id="legacy-hero">
    <div class="hero-glow"></div>
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="eyebrow">Customized AI Academy & Consulting</div>
        <h1>
          We Customize AI <br />
          <span class="gradient-text">Around Your Business.</span>
        </h1>
        <p>
          เราไม่ได้สอนแค่ให้ทีม “ใช้ AI เป็น” แต่ช่วยรื้อโจทย์ธุรกิจ เลือกเครื่องมือให้ถูกงาน 
          และสร้าง <strong>Custom AI Workflow</strong> ที่นำกลับไปใช้งานและวัดผลลัพธ์ทางธุรกิจได้จริงในองค์กรคุณ
        </p>
        
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href="#diagnostic">
            <span>เริ่มจาก AI Business Diagnostic</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#courses">
            <span>สำรวจ 25 หลักสูตร</span>
          </a>
        </div>

        <div class="hero-trust-badges">
          <div class="trust-item">
            <strong>25+</strong>
            <span>Custom Courses</span>
          </div>
          <div class="trust-item">
            <strong>100%</strong>
            <span>Real Business Cases</span>
          </div>
          <div class="trust-item">
            <strong>6M™</strong>
            <span>Systematic Method</span>
          </div>
          <div class="trust-item">
            <strong>5 Levels</strong>
            <span>Readiness Model</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual Card with Real Workshop Preview -->
      <aside class="hero-visual-card">
        <div class="card-top-bar">
          <div class="window-dots">
            <span></span><span></span><span></span>
          </div>
          <div class="live-badge">IN-HOUSE MASTERCLASS</div>
        </div>

        <div class="card-photo-wrapper">
          <img src="/assets/images/workshop-group.jpg" alt="บรรยากาศการอบรม In-house Corporate AI Training โดย Saltcase" width="1024" height="768" loading="eager" fetchpriority="high" />
          <div class="photo-overlay-tag">Corporate AI Transformation Lab</div>
        </div>

        <div class="card-body-content">
          <div class="system-title">SALTCASE AI BUSINESS SYSTEM™</div>
          <div class="system-statement">From Business Problem → AI Workflow → Business Growth → Authority.</div>
          
          <div class="system-flow-list">
            <div class="system-flow-item">
              <span class="flow-num">01</span>
              <span><strong>Diagnose</strong> the real business bottleneck</span>
            </div>
            <div class="system-flow-item">
              <span class="flow-num">02</span>
              <span><strong>Redesign</strong> the human + AI workflow</span>
            </div>
            <div class="system-flow-item">
              <span class="flow-num">03</span>
              <span><strong>Match</strong> the exact AI tool architecture</span>
            </div>
            <div class="system-flow-item">
              <span class="flow-num">04</span>
              <span><strong>Build & Measure</strong> real ROI and business impact</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </header>}

  <!-- Real Workshop Action Showcase (Proof of Work & Experience) -->
  <section class="section-padding" id="action" style="background: var(--bg-dark-subtle);">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Real Action & In-Depth Experience</div>
          <h2 class="section-title">สัมผัสประสบการณ์จริง<br /><span class="gradient-text">เรียนรู้จากงานจริง รื้อไฟล์จริง</span></h2>
        </div>
        <p class="section-desc">
          ภาพบรรยากาศเวิร์กช็อปและการให้คำปรึกษาจริง ที่ AI BizCase Thailand (by Saltcase) เข้าไปร่วมเจาะลึกกระบวนการทำงาน 
          เปรียบเทียบเครื่องมือ และสร้าง AI Copilot ร่วมกับทีมบริหารและพนักงานในองค์กร
        </p>
      </div>

      <div class="gallery-grid">
        <!-- Photo 1: Corporate Workshop Class Group -->
        <article class="gallery-card span-7 large">
          <div class="gallery-image-box">
            <img src="/assets/images/workshop-group.jpg" alt="บรรยากาศจบเวิร์กช็อป Corporate AI Transformation" width="1024" height="768" loading="lazy" />
            <div class="gallery-badge">Corporate In-house Training</div>
          </div>
          <div class="gallery-caption">
            <h3>Corporate AI Transformation & Team Alignment</h3>
            <p>เวิร์กช็อปปรับ Mindset และยกระดับทักษะ AI ให้กับทีมงานทุกระดับ ตั้งแต่ผู้บริหารจนถึงระดับปฏิบัติการ สร้างความพร้อมและวิสัยทัศน์ร่วมกันในองค์กร</p>
            <div class="gallery-tags">
              <span class="gallery-tag-item">✦ All-Hands Training</span>
              <span class="gallery-tag-item">✦ Enterprise Readiness</span>
              <span class="gallery-tag-item">✦ AI Security Mindset</span>
            </div>
          </div>
        </article>

        <!-- Photo 2: Practical AI Workflow & Persona -->
        <article class="gallery-card span-5">
          <div class="gallery-image-box">
            <img src="/assets/images/workshop-workflow.jpg" alt="การออกแบบ Create AI Workflow & AI Persona" width="1024" height="768" loading="lazy" />
            <div class="gallery-badge">Workflow Architecture</div>
          </div>
          <div class="gallery-caption">
            <h3>Practical AI Workflow & Sales Engine</h3>
            <p>สอนเจาะลึกกระบวนการสร้าง AI Persona, Content Generation, Video/Voice AI และการเชื่อมต่อสู่แพลตฟอร์ม E-commerce อย่าง Shopee & TikTok Shop</p>
            <div class="gallery-tags">
              <span class="gallery-tag-item">✦ AI Workflows</span>
              <span class="gallery-tag-item">✦ Content Engine</span>
              <span class="gallery-tag-item">✦ Social Commerce</span>
            </div>
          </div>
        </article>

        <!-- Photo 3: AI Feature Comparison Matrix -->
        <article class="gallery-card span-6">
          <div class="gallery-image-box">
            <img src="/assets/images/workshop-comparison.jpg" alt="เปรียบเทียบฟีเจอร์ AI ยอดนิยมสำหรับธุรกิจ" width="1024" height="768" loading="lazy" />
            <div class="gallery-badge">Decision Matrix</div>
          </div>
          <div class="gallery-caption">
            <h3>AI Tools Benchmark & Feature Comparison</h3>
            <p>วิเคราะห์เปรียบเทียบจุดเด่น-จุดด้อยของ ChatGPT, Claude, Gemini, Perplexity และ Midjourney เพื่อให้ทีมเลือกใช้เครื่องมือได้ตรงกับงานและงบประมาณ</p>
            <div class="gallery-tags">
              <span class="gallery-tag-item">✦ Tool-to-Task Matrix</span>
              <span class="gallery-tag-item">✦ Cost Optimization</span>
              <span class="gallery-tag-item">✦ Model Selection</span>
            </div>
          </div>
        </article>

        <!-- Photo 4: Hands-on Team Consulting -->
        <article class="gallery-card span-6">
          <div class="gallery-image-box">
            <img src="/assets/images/workshop-consulting.jpg" alt="เวิร์กช็อปกลุ่มย่อยแบบจับมือทำรายทีม" width="1024" height="576" loading="lazy" />
            <div class="gallery-badge">Hands-on Lab</div>
          </div>
          <div class="gallery-caption">
            <h3>Intensive Masterclass & 1-on-1 Consulting</h3>
            <p>Session เวิร์กช็อปแบบประกบใกล้ชิด รื้อไฟล์งานจริง ออกแบบ Prompt ร่วมกัน และสร้าง Prototype ระบบงานที่นำไปใช้ได้ทันทีหลังจบการฝึกอบรม</p>
            <div class="gallery-tags">
              <span class="gallery-tag-item">✦ 1-on-1 Mentoring</span>
              <span class="gallery-tag-item">✦ Real Document Review</span>
              <span class="gallery-tag-item">✦ Prompt Engineering</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Problem & Solution Section (Start from the problem) -->
  <section class="section-padding" id="solutions">
    <div class="container">
      <div class="section-head">
        <div>
          <div class="eyebrow">Start From The Real Problem</div>
          <h2 class="section-title">ไม่ต้องเริ่มจาก<br /><span class="gradient-text">“จะเรียน AI ตัวไหน”</span></h2>
        </div>
        <p class="section-desc">
          เริ่มจากสิ่งที่ธุรกิจกำลังติดขัด แล้วค่อยออกแบบหลักสูตร Workflow และเครื่องมือให้เหมาะกับบริบทจริง 
          ไม่ใช่การสอนฟีเจอร์สำเร็จรูปที่ทีมไม่รู้จะนำไปใช้ต่ออย่างไร
        </p>
      </div>

      <div class="problems-grid">
        <article class="problem-card">
          <div>
            <div class="problem-icon-header">
              <div class="problem-icon-wrap">01</div>
              <span class="problem-pain-tag">Lack of Standard</span>
            </div>
            <h3>ทีมต่างคนต่างลอง ไม่มีมาตรฐานความปลอดภัย</h3>
            <p>กลัวข้อมูลลูกค้ารั่วไหล ผลลัพธ์ไม่แน่นอน และผู้บริหารไม่มีนโยบาย AI Governance รองรับ</p>
          </div>
          <div class="problem-route">
            <span>Solution: AI Foundation & Security</span>
            <span>→</span>
          </div>
        </article>

        <article class="problem-card">
          <div>
            <div class="problem-icon-header">
              <div class="problem-icon-wrap">02</div>
              <span class="problem-pain-tag">Heavy Manual Work</span>
            </div>
            <h3>งานเอกสารท่วมตัว นั่งคัดลอกสรุปจนหมดวัน</h3>
            <p>เสียเวลาคัดลอกข้อมูล ตรวจทานสัญญา และสรุปรายงานด้วยมือซ้ำ ๆ ทุกสัปดาห์</p>
          </div>
          <div class="problem-route">
            <span>Solution: Document Intelligence</span>
            <span>→</span>
          </div>
        </article>

        <article class="problem-card">
          <div>
