---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---
<a class:list={['brand-logo', 'brand-logo--ab', { compact }]} href="/#top" aria-label="AI BizCase Thailand (by Saltcase) หน้าแรก">
  <picture>
    <source srcset="/assets/images/aibizcase-logo.webp" type="image/webp" />
    <img src="/assets/images/aibizcase-logo-560.png" alt="AI BizCase Thailand" width="560" height="207" decoding="async" />
  </picture>
</a>
